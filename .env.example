# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional default GitHub Personal Access Token (PAT) with repo/workflow scope
# Users can also configure their own GitHub credentials directly in the app settings UI
GITHUB_TOKEN=""

# GITHUB_REPO: Optional default repository (format: owner/repo) for dispatching Android APK builds
GITHUB_REPO=""
